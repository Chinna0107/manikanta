        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .about-screen {\n    --navy: #08183A;\n    --gold: #D4AF37;\n    --maroon: #2D1A10;\n    --cream: #FDFBF7;\n    --red: #D61A3C;\n    font-family: 'Poppins', sans-serif;\n  }\n\n  .about-display {\n    font-family: 'Playfair Display', serif;\n  }\n\n  .aisle-summary::-webkit-details-marker {\n    display: none;\n  }\n\n  details[open] .aisle-chevron {\n    transform: rotate(180deg);\n  }\n\n  details[open] .aisle-title {\n    color: var(--red);\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .about-screen *,\n    .about-screen *::before,\n    .about-screen *::after {\n      animation-duration: 0.01ms !important;\n      animation-iteration-count: 1 !important;\n      scroll-behavior: auto !important;\n      transition-duration: 0.01ms !important;\n    }\n  }\n</style>\n<div class=\"about-screen min-h-screen overflow-x-hidden bg-[var(--cream)] pb-32 text-[var(--navy)] antialiased\" data-kid=\"1\" data-name=\"about screen container\" id=\"top\">\n    <div class=\"flex items-center justify-between px-5 pb-2 pt-5\" data-kid=\"1-1\" data-name=\"header container\">\n        <p class=\"text-[10px] font-bold uppercase tracking-[0.24em] text-[var(--maroon)]/70\" data-kid=\"1-1-1\" data-name=\"brand name text\">\n            Manikanta\n        </p>\n        <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[var(--gold)]/35 bg-white/70 px-3 py-1.5 text-[10px] font-semibold text-[var(--navy)] shadow-xs\" data-kid=\"1-1-2\" data-name=\"story label with sparkles icon\">\n            <i aria-hidden=\"true\" class=\"ti ti-sparkles text-[12px]\" data-kid=\"1-1-2-1\" data-name=\"sparkles icon\" style=\"width:12px;height:12px;color:var(--gold);\">\n            </i>\n            Our story\n        </span>\n    </div>\n    <main data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"about-heading\" class=\"relative overflow-hidden\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"relative h-[440px] overflow-hidden rounded-b-[36px]\" data-kid=\"1-2-1-1\" data-name=\"hero background image container\">\n                <img alt=\"Warm, inviting grocery aisle with wooden shelves — Orhan Pergel on Pexels\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-2-1-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/18764913/pexels-photo-18764913.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n                <div class=\"absolute inset-0 bg-gradient-to-b from-[var(--navy)]/35 via-transparent to-[var(--cream)]\" data-kid=\"1-2-1-1-2\" data-name=\"hero image gradient overlay\">\n                </div>\n                <div class=\"absolute left-1/2 top-7 -translate-x-1/2 text-center\" data-kid=\"1-2-1-1-3\" data-name=\"logo and brand text container\">\n                    <div class=\"mx-auto flex h-[68px] w-[68px] items-center justify-center rounded-[22px] border border-white/70 bg-white/90 p-2 shadow-lg backdrop-blur-xs\" data-kid=\"1-2-1-1-3-1\" data-name=\"logo container\">\n                        <img alt=\"Manikanta Super Market logo\" class=\"h-full w-full object-contain\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"market logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/logo.png\"/>\n                    </div>\n                    <p class=\"mt-2 text-[9px] font-bold uppercase tracking-[0.22em] text-white drop-shadow-sm\" data-kid=\"1-2-1-1-3-2\" data-name=\"brand full name text\">\n                        Manikanta Super Market\n                    </p>\n                </div>\n                <div class=\"absolute inset-x-3 bottom-3 rounded-[26px] bg-[var(--cream)]/95 px-4 pb-5 pt-4 shadow-sm backdrop-blur-xs\" data-kid=\"1-2-1-1-4\" data-name=\"hero content container\">\n                    <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.28em] text-[var(--red)]\" data-kid=\"1-2-1-1-4-1\" data-name=\"story section label\">\n                        OUR STORY\n                    </p>\n                    <h1 class=\"about-display max-w-[340px] text-[35px] font-bold leading-[1.04] tracking-[-0.03em] text-[var(--navy)]\" data-kid=\"1-2-1-1-4-2\" data-name=\"hero headline text\" id=\"about-heading\">\n                        A familiar market, made for your everyday.\n                    </h1>\n                    <p class=\"mt-3 max-w-[340px] text-[13px] leading-[1.65] text-[var(--maroon)]/80\" data-kid=\"1-2-1-1-4-3\" data-name=\"hero description text\">\n                        Manikanta Super Market is here for the moments between the big plans: a quick top-up, a fresh dinner, and the ingredients that make home feel like home.\n                    </p>\n                    <a class=\"mt-4 inline-flex items-center gap-2 rounded-full bg-[var(--navy)] px-4 py-2.5 text-[12px] font-semibold text-[var(--cream)] shadow-sm transition-transform duration-200 hover:-translate-y-0.5 active:scale-[0.98]\" data-kid=\"1-2-1-1-4-4\" data-name=\"explore aisles button\" href=\"#aisles\">\n                        Explore the aisles\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[15px]\" data-kid=\"1-2-1-1-4-4-1\" data-name=\"arrow up right icon\" style=\"width:15px;height:15px;color:var(--cream);\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"journey-heading\" class=\"px-5 pb-10 pt-12\" data-kid=\"1-2-2\" data-name=\"journey section\" id=\"journey\">\n            <div class=\"flex items-end justify-between gap-3\" data-kid=\"1-2-2-1\" data-name=\"journey section heading container\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"journey heading text group\">\n                    <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.24em] text-[var(--red)]\" data-kid=\"1-2-2-1-1-1\" data-name=\"how we work section label\">\n                        HOW WE WORK\n                    </p>\n                    <h2 class=\"about-display text-[30px] font-bold leading-[1.05] tracking-[-0.025em] text-[var(--navy)]\" data-kid=\"1-2-2-1-1-2\" data-name=\"journey section heading\" id=\"journey-heading\">\n                        From shelf to home\n                    </h2>\n                </div>\n                <span class=\"mb-1 shrink-0 rounded-full bg-[var(--navy)] px-2.5 py-1 text-[10px] font-semibold text-[var(--gold)]\" data-kid=\"1-2-2-1-2\" data-name=\"step count badge\">\n                    03 steps\n                </span>\n            </div>\n            <p class=\"mt-3 max-w-[320px] text-[13px] leading-[1.65] text-[var(--maroon)]/70\" data-kid=\"1-2-2-2\" data-name=\"journey description text\">\n                The everyday details are where our promise lives.\n            </p>\n            <div class=\"relative mt-8\" data-kid=\"1-2-2-3\" data-name=\"journey steps container\">\n                <div aria-hidden=\"true\" class=\"absolute bottom-7 left-[11px] top-3 w-px bg-[var(--gold)]/65\" data-kid=\"1-2-2-3-1\" data-name=\"journey timeline connecting line\">\n                </div>\n                <div class=\"space-y-7\" data-kid=\"1-2-2-3-2\" data-name=\"journey steps list\">\n                    <article class=\"relative pl-10\" data-kid=\"1-2-2-3-2-1\" data-name=\"first step article\">\n                        <span aria-hidden=\"true\" class=\"absolute left-0 top-0 flex h-6 w-6 items-center justify-center rounded-full border-4 border-[var(--cream)] bg-[var(--red)] shadow-sm\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"first step marker\">\n                        </span>\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--gold)]\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"first step label\">\n                            01 / THE START\n                        </p>\n                        <h3 class=\"about-display mt-1 text-[22px] font-bold text-[var(--navy)]\" data-kid=\"1-2-2-3-2-1-3\" data-name=\"first step title\">\n                            Sourced with care\n                        </h3>\n                        <p class=\"mt-1.5 text-[13px] leading-[1.65] text-[var(--maroon)]/75\" data-kid=\"1-2-2-3-2-1-4\" data-name=\"first step description\">\n                            We choose trusted suppliers and everyday staples with your kitchen in mind.\n                        </p>\n                    </article>\n                    <article class=\"relative pl-10\" data-kid=\"1-2-2-3-2-2\" data-name=\"second step article\">\n                        <span aria-hidden=\"true\" class=\"absolute left-0 top-0 flex h-6 w-6 items-center justify-center rounded-full border-4 border-[var(--cream)] bg-[var(--red)] shadow-sm\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"second step marker\">\n                        </span>\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--gold)]\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"second step label\">\n                            02 / THE RHYTHM\n                        </p>\n                        <h3 class=\"about-display mt-1 text-[22px] font-bold text-[var(--navy)]\" data-kid=\"1-2-2-3-2-2-3\" data-name=\"second step title\">\n                            Stocked fresh daily\n                        </h3>\n                        <p class=\"mt-1.5 text-[13px] leading-[1.65] text-[var(--maroon)]/75\" data-kid=\"1-2-2-3-2-2-4\" data-name=\"second step description\">\n                            Our team keeps produce, dairy, bakery, and pantry shelves ready for the day ahead.\n                        </p>\n                    </article>\n                    <article class=\"relative pl-10\" data-kid=\"1-2-2-3-2-3\" data-name=\"third step article\">\n                        <span aria-hidden=\"true\" class=\"absolute left-0 top-0 flex h-6 w-6 items-center justify-center rounded-full border-4 border-[var(--cream)] bg-[var(--red)] shadow-sm\" data-kid=\"1-2-2-3-2-3-1\" data-name=\"third step marker\">\n                        </span>\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--gold)]\" data-kid=\"1-2-2-3-2-3-2\" data-name=\"third step label\">\n                            03 / THE HANDOFF\n                        </p>\n                        <h3 class=\"about-display mt-1 text-[22px] font-bold text-[var(--navy)]\" data-kid=\"1-2-2-3-2-3-3\" data-name=\"third step title\">\n                            Packed for your plans\n                        </h3>\n                        <p class=\"mt-1.5 text-[13px] leading-[1.65] text-[var(--maroon)]/75\" data-kid=\"1-2-2-3-2-3-4\" data-name=\"third step description\">\n                            Walk in, order ahead, or choose pickup — we make the handoff easy.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"aisles-heading\" class=\"border-t border-[var(--gold)]/25 pb-8 pt-10\" data-kid=\"1-2-3\" data-name=\"aisles section\" id=\"aisles\">\n            <div class=\"px-5\" data-kid=\"1-2-3-1\" data-name=\"aisles header container\">\n                <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.24em] text-[var(--red)]\" data-kid=\"1-2-3-1-1\" data-name=\"aisles section label\">\n                    WHAT WE KEEP READY\n                </p>\n                <h2 class=\"about-display text-[30px] font-bold leading-[1.05] tracking-[-0.025em] text-[var(--navy)]\" data-kid=\"1-2-3-1-2\" data-name=\"aisles section heading\" id=\"aisles-heading\">\n                    Our everyday aisles\n                </h2>\n                <p class=\"mt-3 text-[13px] leading-[1.65] text-[var(--maroon)]/70\" data-kid=\"1-2-3-1-3\" data-name=\"aisles description text\">\n                    Tap an aisle to see what makes it part of your weekly rhythm.\n                </p>\n            </div>\n            <div class=\"mt-7 border-y border-[var(--gold)]/35 bg-white/45\" data-kid=\"1-2-3-2\" data-name=\"aisles list container\">\n                <details class=\"group border-b border-[var(--gold)]/25 px-5 py-4\" data-kid=\"1-2-3-2-1\" data-name=\"fresh produce accordion\" open=\"\">\n                    <summary class=\"aisle-summary flex cursor-pointer list-none items-center gap-3 outline-hidden transition-colors duration-200\" data-kid=\"1-2-3-2-1-1\" data-name=\"fresh produce summary bar\">\n                        <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--red)] text-[11px] font-bold text-white\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"fresh produce index number\">\n                            01\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"fresh produce text container\">\n                            <span class=\"aisle-title block text-[15px] font-semibold text-[var(--navy)] transition-colors duration-200\" data-kid=\"1-2-3-2-1-1-2-1\" data-name=\"fresh produce title\">\n                                Fresh produce\n                            </span>\n                            <span class=\"mt-0.5 block text-[11px] text-[var(--maroon)]/55\" data-kid=\"1-2-3-2-1-1-2-2\" data-name=\"fresh produce subtitle\">\n                                Picked for color and crunch.\n                            </span>\n                        </span>\n                        <i aria-hidden=\"true\" class=\"aisle-chevron ti ti-chevron-down text-[18px] transition-transform duration-200\" data-kid=\"1-2-3-2-1-1-3\" data-name=\"fresh produce chevron icon\" style=\"width:18px;height:18px;color:var(--gold);\">\n                        </i>\n                    </summary>\n                    <p class=\"ml-11 mt-3 border-l-2 border-[var(--gold)]/45 pl-3 text-[13px] leading-[1.6] text-[var(--maroon)]/75\" data-kid=\"1-2-3-2-1-2\" data-name=\"fresh produce details text\">\n                        Crisp greens, seasonal fruits, and colorful vegetables.\n                    </p>\n                </details>\n                <details class=\"group border-b border-[var(--gold)]/25 px-5 py-4\" data-kid=\"1-2-3-2-2\" data-name=\"dairy bakery accordion\">\n                    <summary class=\"aisle-summary flex cursor-pointer list-none items-center gap-3 outline-hidden transition-colors duration-200\" data-kid=\"1-2-3-2-2-1\" data-name=\"dairy bakery summary bar\">\n                        <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--navy)] text-[11px] font-bold text-[var(--gold)]\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"dairy bakery index number\">\n                            02\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"dairy bakery text container\">\n                            <span class=\"aisle-title block text-[15px] font-semibold text-[var(--navy)] transition-colors duration-200\" data-kid=\"1-2-3-2-2-1-2-1\" data-name=\"dairy bakery title\">\n                                Dairy & bakery\n                            </span>\n                            <span class=\"mt-0.5 block text-[11px] text-[var(--maroon)]/55\" data-kid=\"1-2-3-2-2-1-2-2\" data-name=\"dairy bakery subtitle\">\n                                The small comforts of breakfast.\n                            </span>\n                        </span>\n                        <i aria-hidden=\"true\" class=\"aisle-chevron ti ti-chevron-down text-[18px] transition-transform duration-200\" data-kid=\"1-2-3-2-2-1-3\" data-name=\"dairy bakery chevron icon\" style=\"width:18px;height:18px;color:var(--gold);\">\n                        </i>\n                    </summary>\n                    <p class=\"ml-11 mt-3 border-l-2 border-[var(--gold)]/45 pl-3 text-[13px] leading-[1.6] text-[var(--maroon)]/75\" data-kid=\"1-2-3-2-2-2\" data-name=\"dairy bakery details text\">\n                        Milk, eggs, breads, and the small comforts that make breakfast better.\n                    </p>\n                </details>\n                <details class=\"group px-5 py-4\" data-kid=\"1-2-3-2-3\" data-name=\"pantry essentials accordion\">\n                    <summary class=\"aisle-summary flex cursor-pointer list-none items-center gap-3 outline-hidden transition-colors duration-200\" data-kid=\"1-2-3-2-3-1\" data-name=\"pantry essentials summary bar\">\n                        <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--navy)] text-[11px] font-bold text-[var(--gold)]\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"pantry essentials index number\">\n                            03\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-2-3-2-3-1-2\" data-name=\"pantry essentials text container\">\n                            <span class=\"aisle-title block text-[15px] font-semibold text-[var(--navy)] transition-colors duration-200\" data-kid=\"1-2-3-2-3-1-2-1\" data-name=\"pantry essentials title\">\n                                Pantry essentials\n                            </span>\n                            <span class=\"mt-0.5 block text-[11px] text-[var(--maroon)]/55\" data-kid=\"1-2-3-2-3-1-2-2\" data-name=\"pantry essentials subtitle\">\n                                A steady base for the week.\n                            </span>\n                        </span>\n                        <i aria-hidden=\"true\" class=\"aisle-chevron ti ti-chevron-down text-[18px] transition-transform duration-200\" data-kid=\"1-2-3-2-3-1-3\" data-name=\"pantry essentials chevron icon\" style=\"width:18px;height:18px;color:var(--gold);\">\n                        </i>\n                    </summary>\n                    <p class=\"ml-11 mt-3 border-l-2 border-[var(--gold)]/45 pl-3 text-[13px] leading-[1.6] text-[var(--maroon)]/75\" data-kid=\"1-2-3-2-3-2\" data-name=\"pantry essentials details text\">\n                        Rice, lentils, spices, snacks, and household basics for the week.\n                    </p>\n                </details>\n            </div>\n        </section>\n        <section aria-label=\"Closing note\" class=\"px-5 pb-4 pt-3\" data-kid=\"1-2-4\" data-name=\"closing note section\">\n            <div class=\"rounded-[26px] bg-[var(--navy)] px-5 py-5 text-[var(--cream)] shadow-sm\" data-kid=\"1-2-4-1\" data-name=\"closing note container\">\n                <div class=\"flex items-start gap-3\" data-kid=\"1-2-4-1-1\" data-name=\"closing note content wrapper\">\n                    <i aria-hidden=\"true\" class=\"ti ti-heart-handshake mt-0.5 text-[20px]\" data-kid=\"1-2-4-1-1-1\" data-name=\"heart handshake icon\" style=\"width:20px;height:20px;color:var(--gold);\">\n                    </i>\n                    <div data-kid=\"1-2-4-1-1-2\" data-name=\"closing note text container\">\n                        <p class=\"about-display text-[20px] font-bold leading-tight\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"closing note headline\">\n                            Good food starts close to home.\n                        </p>\n                        <p class=\"mt-2 text-[12px] leading-[1.6] text-[var(--cream)]/70\" data-kid=\"1-2-4-1-1-2-2\" data-name=\"closing note body text\">\n                            Thank you for letting us be part of your everyday.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <nav aria-label=\"Shopping actions\" class=\"fixed inset-x-0 bottom-0 z-40 border-t border-[var(--gold)]/35 bg-[var(--cream)]/95 px-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] pt-3 backdrop-blur-xs\" data-kid=\"1-3\" data-name=\"shopping actions navigation bar\">\n        <div class=\"mx-auto flex max-w-[375px] gap-2\" data-kid=\"1-3-1\" data-name=\"nav buttons container\">\n            <a class=\"inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-2xl border border-[var(--navy)]/25 bg-transparent px-3 text-[12px] font-semibold text-[var(--navy)] transition-colors duration-200 hover:bg-white active:scale-[0.98]\" data-kid=\"1-3-1-1\" data-name=\"find store button\" href=\"#journey\">\n                <i aria-hidden=\"true\" class=\"ti ti-map-pin text-[16px]\" data-kid=\"1-3-1-1-1\" data-name=\"location pin icon\" style=\"width:16px;height:16px;color:var(--navy);\">\n                </i>\n                Find a store\n            </a>\n            <a class=\"inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-2xl bg-[var(--red)] px-3 text-[12px] font-semibold text-white shadow-sm transition-transform duration-200 hover:-translate-y-0.5 active:scale-[0.98]\" data-kid=\"1-3-1-2\" data-name=\"order groceries button\" href=\"#aisles\">\n                <i aria-hidden=\"true\" class=\"ti ti-shopping-cart text-[16px]\" data-kid=\"1-3-1-2-1\" data-name=\"shopping cart icon\" style=\"width:16px;height:16px;color:white;\">\n                </i>\n                Order groceries\n            </a>\n        </div>\n    </nav>\n</div>\n",
      "comments": [],
      "created": "2026-08-12T13:02:07.670938+00:00",
      "modified": "2026-08-12T13:04:12.574486+00:00",
      "id": "var_41efbafa9da1",
      "viewportScrollY": 0
    }
  },
  "comments": [],
  "nextCommentNumber": 1
}