      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  html { scroll-behavior: smooth; }\n  .app-shell { font-family: 'Poppins', sans-serif; }\n  .display-face { font-family: 'Poppins', sans-serif; }\n  .quote-face { font-family: 'Playfair Display', serif; }\n  .hide-scrollbar::-webkit-scrollbar { display: none; }\n  .hide-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n    *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }\n  }\n</style>\n<div class=\"app-shell min-h-screen bg-[#F4EBE0] text-[#333333] antialiased\" data-kid=\"1\" data-name=\"app wrapper\" id=\"top\">\n    <main class=\"relative mx-auto min-h-screen w-full max-w-[420px] overflow-hidden bg-white pb-32 shadow-[0_0_40px_rgba(51,51,51,0.08)]\" data-kid=\"1-1\" data-name=\"main content container\">\n        <header class=\"sticky top-0 z-30 flex h-[68px] items-center justify-between border-b border-[#333333]/[0.07] bg-white/95 px-4 backdrop-blur-md\" data-kid=\"1-1-1\" data-name=\"sticky header\">\n            <a aria-label=\"Manikanta Super Market home\" class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"logo and brand link\" href=\"#top\">\n                <span class=\"flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-[13px] bg-[#FFC107] shadow-[0_4px_10px_rgba(255,193,7,0.28)]\" data-kid=\"1-1-1-1-1\" data-name=\"logo container\">\n                    <img alt=\"Manikanta Super Market logo\" class=\"h-9 w-9 object-contain\" data-kid=\"1-1-1-1-1-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/logo.png\"/>\n                </span>\n                <span class=\"min-w-0 leading-none\" data-kid=\"1-1-1-1-2\" data-name=\"brand name group\">\n                    <span class=\"block truncate text-[13px] font-extrabold tracking-[-0.03em] text-[#D61A3C]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        MANIKANTA\n                    </span>\n                    <span class=\"mt-1 block truncate text-[8px] font-semibold tracking-[0.18em] text-[#333333]/60\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                        SUPER MARKET\n                    </span>\n                </span>\n            </a>\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-2\" data-name=\"header actions container\">\n                <span class=\"flex items-center gap-1.5 rounded-full bg-[#F4EBE0] px-2.5 py-1.5 text-[9px] font-extrabold tracking-[0.08em] text-[#333333]\" data-kid=\"1-1-1-2-1\" data-name=\"open status badge\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#2F9E44] shadow-[0_0_0_3px_rgba(47,158,68,0.12)]\" data-kid=\"1-1-1-2-1-1\" data-name=\"status indicator dot\">\n                    </span>\n                    OPEN TODAY\n                </span>\n                <a aria-label=\"Start shopping\" class=\"flex h-10 w-10 items-center justify-center rounded-[13px] bg-[#D61A3C] text-white shadow-[0_6px_14px_rgba(214,26,60,0.24)] transition-transform duration-200 hover:-translate-y-0.5 active:scale-95\" data-kid=\"1-1-1-2-2\" data-name=\"shopping cart button\" href=\"#shop\">\n                    <i aria-hidden=\"true\" class=\"ti ti-shopping-bag\" data-kid=\"1-1-1-2-2-1\" data-name=\"shopping bag icon\" style=\"display:block;width:18px;height:18px;line-height:18px;font-size:18px;color:#FFFFFF\">\n                    </i>\n                </a>\n            </div>\n        </header>\n        <section aria-labelledby=\"about-hero-title\" data-kid=\"1-1-2\" data-name=\"hero section\">\n            <figure class=\"relative h-[218px] overflow-hidden bg-[#08183A]\" data-kid=\"1-1-2-1\" data-name=\"hero video figure\">\n                <video aria-label=\"Shoppers choosing fresh citrus in a grocery market\" autoplay=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-1-1\" data-name=\"hero background video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/4121714/choosing-citrus-consumer-couple-4121714.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/4121714/4121714-hd_1280_720_50fps.mp4\">\n                </video>\n                <div class=\"pointer-events-none absolute inset-0 bg-gradient-to-t from-[#08183A]/75 via-[#08183A]/10 to-transparent\" data-kid=\"1-1-2-1-2\" data-name=\"hero gradient overlay\">\n                </div>\n                <div class=\"absolute bottom-4 left-4 flex items-center gap-2 rounded-full bg-white/90 px-3 py-1.5 text-[9px] font-bold tracking-[0.08em] text-[#333333] shadow-lg backdrop-blur-sm\" data-kid=\"1-1-2-1-3\" data-name=\"hero highlight badge\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#D61A3C]\" data-kid=\"1-1-2-1-3-1\" data-name=\"badge indicator dot\">\n                    </span>\n                    FRESH • FAST • LOCAL\n                </div>\n                <figcaption class=\"absolute bottom-2 right-3 max-w-[155px] text-right text-[7px] leading-tight text-white/75\" data-kid=\"1-1-2-1-4\" data-name=\"video attribution caption\">\n                    Video: Jack Sparrow on Pexels\n                </figcaption>\n            </figure>\n            <div class=\"relative -mt-1 rounded-t-[26px] bg-white px-5 pb-7 pt-7\" data-kid=\"1-1-2-2\" data-name=\"hero content container\">\n                <p class=\"mb-3 text-[10px] font-extrabold tracking-[0.18em] text-[#D61A3C]\" data-kid=\"1-1-2-2-1\" data-name=\"hero pre-headline\">\n                    THE EVERYDAY MARKET\n                </p>\n                <h1 class=\"display-face max-w-[315px] text-[31px] font-extrabold leading-[1.06] tracking-[-0.055em] text-[#333333]\" data-kid=\"1-1-2-2-2\" data-name=\"hero headline\" id=\"about-hero-title\">\n                    The quick way to stock your kitchen.\n                </h1>\n                <p class=\"mt-4 max-w-[330px] text-[13px] leading-[1.65] text-[#333333]/70\" data-kid=\"1-1-2-2-3\" data-name=\"hero description text\">\n                    We’ve reimagined the neighborhood market for busy days — fresh produce, dairy, pantry staples, and household essentials, ready when you are.\n                </p>\n                <a class=\"mt-5 inline-flex h-12 w-full items-center justify-between rounded-[15px] bg-[#D61A3C] px-4 text-[13px] font-extrabold text-white shadow-[0_9px_20px_rgba(214,26,60,0.22)] transition-transform duration-200 hover:-translate-y-0.5 active:scale-[0.99]\" data-kid=\"1-1-2-2-4\" data-name=\"primary call-to-action button\" href=\"#promise\" id=\"shop\">\n                    <span data-kid=\"1-1-2-2-4-1\" data-name=\"button label\">\n                        Shop groceries\n                    </span>\n                    <span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-white/15\" data-kid=\"1-1-2-2-4-2\" data-name=\"button icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-1-2-2-4-2-1\" data-name=\"arrow icon\" style=\"display:block;width:16px;height:16px;line-height:16px;font-size:16px;color:#FFFFFF\">\n                        </i>\n                    </span>\n                </a>\n            </div>\n        </section>\n        <section aria-labelledby=\"difference-title\" class=\"border-t border-[#333333]/[0.06] bg-[#FDFBF7] px-4 pb-8 pt-7\" data-kid=\"1-1-3\" data-name=\"why us section\" id=\"promise\">\n            <div class=\"mb-4 flex items-end justify-between gap-4\" data-kid=\"1-1-3-1\" data-name=\"section header group\">\n                <div data-kid=\"1-1-3-1-1\" data-name=\"section title container\">\n                    <p class=\"mb-2 text-[9px] font-extrabold tracking-[0.16em] text-[#D61A3C]\" data-kid=\"1-1-3-1-1-1\" data-name=\"section pre-headline\">\n                        WHY MANIKANTA\n                    </p>\n                    <h2 class=\"display-face text-[24px] font-extrabold leading-[1.1] tracking-[-0.045em] text-[#333333]\" data-kid=\"1-1-3-1-1-2\" data-name=\"section headline\" id=\"difference-title\">\n                        Small details.\n                        <br data-kid=\"1-1-3-1-1-2-1\" data-name=\"line break\"/>\n                        Big difference.\n                    </h2>\n                </div>\n                <span class=\"mb-1 rounded-full bg-[#FFC107] px-2.5 py-1 text-[9px] font-extrabold text-[#333333]\" data-kid=\"1-1-3-1-2\" data-name=\"section tag badge\">\n                    OUR PROMISE\n                </span>\n            </div>\n            <div class=\"grid grid-cols-2 gap-2.5\" data-kid=\"1-1-3-2\" data-name=\"features grid\">\n                <article class=\"relative col-span-2 min-h-[205px] overflow-hidden rounded-[22px] bg-[#F4EBE0] p-4 shadow-[0_7px_18px_rgba(51,51,51,0.06)]\" data-kid=\"1-1-3-2-1\" data-name=\"featured highlight card\">\n                    <img alt=\"Freshly baked bread at a bakery — arh Lee on Unsplash\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-1-3-2-1-1\" data-name=\"feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1747456909474-b3732585b330?auto=format&fit=crop&w=700&q=80\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-r from-[#08183A]/85 via-[#08183A]/35 to-transparent\" data-kid=\"1-1-3-2-1-2\" data-name=\"feature image gradient overlay\">\n                    </div>\n                    <div class=\"relative flex h-full max-w-[205px] flex-col justify-between text-white\" data-kid=\"1-1-3-2-1-3\" data-name=\"featured content container\">\n                        <div class=\"flex h-9 w-9 items-center justify-center rounded-[11px] bg-[#FFC107] text-[#333333]\" data-kid=\"1-1-3-2-1-3-1\" data-name=\"feature icon container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-package-check\" data-kid=\"1-1-3-2-1-3-1-1\" data-name=\"package check icon\" style=\"display:block;width:19px;height:19px;line-height:19px;font-size:19px;color:#333333\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-1-3-2-1-3-2\" data-name=\"feature text container\">\n                            <h3 class=\"display-face text-[21px] font-extrabold leading-none tracking-[-0.04em]\" data-kid=\"1-1-3-2-1-3-2-1\" data-name=\"feature title\">\n                                Quality checked\n                            </h3>\n                            <p class=\"mt-2 text-[11px] leading-[1.5] text-white/85\" data-kid=\"1-1-3-2-1-3-2-2\" data-name=\"feature description\">\n                                Every apple, loaf, and packet is checked by our team before it reaches your bag.\n                            </p>\n                            <p class=\"mt-3 text-[8px] font-bold tracking-[0.12em] text-[#FFC107]\" data-kid=\"1-1-3-2-1-3-2-3\" data-name=\"feature highlight label\">\n                                HANDLED WITH CARE\n                            </p>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"min-h-[152px] rounded-[22px] bg-[#F4EBE0] p-4 shadow-[0_7px_18px_rgba(51,51,51,0.06)]\" data-kid=\"1-1-3-2-2\" data-name=\"feature card\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-[11px] bg-white text-[#D61A3C] shadow-sm\" data-kid=\"1-1-3-2-2-1\" data-name=\"feature icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-package-check\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"package check icon\" style=\"display:block;width:18px;height:18px;line-height:18px;font-size:18px;color:#D61A3C\">\n                        </i>\n                    </div>\n                    <h3 class=\"mt-5 text-[14px] font-extrabold leading-[1.1] tracking-[-0.02em] text-[#333333]\" data-kid=\"1-1-3-2-2-2\" data-name=\"feature title\">\n                        Freshly stocked\n                    </h3>\n                    <p class=\"mt-2 text-[10px] leading-[1.45] text-[#333333]/65\" data-kid=\"1-1-3-2-2-3\" data-name=\"feature description\">\n                        Daily essentials kept ready for your routine.\n                    </p>\n                </article>\n                <article class=\"min-h-[152px] rounded-[22px] bg-[#F4EBE0] p-4 shadow-[0_7px_18px_rgba(51,51,51,0.06)]\" data-kid=\"1-1-3-2-3\" data-name=\"feature card\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-[11px] bg-white text-[#D61A3C] shadow-sm\" data-kid=\"1-1-3-2-3-1\" data-name=\"feature icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-clock\" data-kid=\"1-1-3-2-3-1-1\" data-name=\"clock icon\" style=\"display:block;width:18px;height:18px;line-height:18px;font-size:18px;color:#D61A3C\">\n                        </i>\n                    </div>\n                    <h3 class=\"mt-5 text-[14px] font-extrabold leading-[1.1] tracking-[-0.02em] text-[#333333]\" data-kid=\"1-1-3-2-3-2\" data-name=\"feature title\">\n                        Easy pickup\n                    </h3>\n                    <p class=\"mt-2 text-[10px] leading-[1.45] text-[#333333]/65\" data-kid=\"1-1-3-2-3-3\" data-name=\"feature description\">\n                        Order ahead and collect without the wait.\n                    </p>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"steps-title\" class=\"bg-white px-4 py-7\" data-kid=\"1-1-4\" data-name=\"how it works section\">\n            <div class=\"mb-4 flex items-end justify-between\" data-kid=\"1-1-4-1\" data-name=\"section header group\">\n                <div data-kid=\"1-1-4-1-1\" data-name=\"section title container\">\n                    <p class=\"mb-2 text-[9px] font-extrabold tracking-[0.16em] text-[#D61A3C]\" data-kid=\"1-1-4-1-1-1\" data-name=\"section pre-headline\">\n                        HOW IT WORKS\n                    </p>\n                    <h2 class=\"display-face text-[23px] font-extrabold leading-none tracking-[-0.045em] text-[#333333]\" data-kid=\"1-1-4-1-1-2\" data-name=\"section headline\" id=\"steps-title\">\n                        From shelf to table.\n                    </h2>\n                </div>\n                <span class=\"text-[10px] font-bold text-[#333333]/40\" data-kid=\"1-1-4-1-2\" data-name=\"step counter\">\n                    01 — 03\n                </span>\n            </div>\n            <div class=\"hide-scrollbar -mx-4 flex snap-x gap-2.5 overflow-x-auto px-4 pb-1\" data-kid=\"1-1-4-2\" data-name=\"steps carousel\">\n                <article class=\"w-[142px] shrink-0 snap-start rounded-[18px] border border-[#333333]/[0.08] bg-white p-3.5 shadow-[0_5px_15px_rgba(51,51,51,0.05)]\" data-kid=\"1-1-4-2-1\" data-name=\"step card\">\n                    <span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#D61A3C] text-[11px] font-extrabold text-white\" data-kid=\"1-1-4-2-1-1\" data-name=\"step number badge\">\n                        01\n                    </span>\n                    <h3 class=\"mt-6 text-[13px] font-extrabold text-[#333333]\" data-kid=\"1-1-4-2-1-2\" data-name=\"step title\">\n                        Choose\n                    </h3>\n                    <p class=\"mt-1.5 text-[10px] leading-[1.45] text-[#333333]/60\" data-kid=\"1-1-4-2-1-3\" data-name=\"step description\">\n                        Pick what your kitchen needs today.\n                    </p>\n                </article>\n                <article class=\"w-[142px] shrink-0 snap-start rounded-[18px] border border-[#333333]/[0.08] bg-white p-3.5 shadow-[0_5px_15px_rgba(51,51,51,0.05)]\" data-kid=\"1-1-4-2-2\" data-name=\"step card\">\n                    <span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#FFC107] text-[11px] font-extrabold text-[#333333]\" data-kid=\"1-1-4-2-2-1\" data-name=\"step number badge\">\n                        02\n                    </span>\n                    <h3 class=\"mt-6 text-[13px] font-extrabold text-[#333333]\" data-kid=\"1-1-4-2-2-2\" data-name=\"step title\">\n                        We pack\n                    </h3>\n                    <p class=\"mt-1.5 text-[10px] leading-[1.45] text-[#333333]/60\" data-kid=\"1-1-4-2-2-3\" data-name=\"step description\">\n                        We check, sort, and pack it with care.\n                    </p>\n                </article>\n                <article class=\"w-[142px] shrink-0 snap-start rounded-[18px] border border-[#333333]/[0.08] bg-white p-3.5 shadow-[0_5px_15px_rgba(51,51,51,0.05)]\" data-kid=\"1-1-4-2-3\" data-name=\"step card\">\n                    <span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#F4EBE0] text-[11px] font-extrabold text-[#D61A3C]\" data-kid=\"1-1-4-2-3-1\" data-name=\"step number badge\">\n                        03\n                    </span>\n                    <h3 class=\"mt-6 text-[13px] font-extrabold text-[#333333]\" data-kid=\"1-1-4-2-3-2\" data-name=\"step title\">\n                        You enjoy\n                    </h3>\n                    <p class=\"mt-1.5 text-[10px] leading-[1.45] text-[#333333]/60\" data-kid=\"1-1-4-2-3-3\" data-name=\"step description\">\n                        More time for the people and meals you love.\n                    </p>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"quote-title\" class=\"relative overflow-hidden bg-[#D61A3C] px-5 py-10 text-white\" data-kid=\"1-1-5\" data-name=\"quote section\">\n            <span class=\"quote-face pointer-events-none absolute -right-2 -top-10 text-[170px] font-bold leading-none text-white/10\" data-kid=\"1-1-5-1\" data-name=\"decorative quote mark\">\n                “\n            </span>\n            <div class=\"relative z-10\" data-kid=\"1-1-5-2\" data-name=\"quote content container\">\n                <span class=\"mb-5 block h-1 w-10 rounded-full bg-[#FFC107]\" data-kid=\"1-1-5-2-1\" data-name=\"quote decorative line\">\n                </span>\n                <h2 class=\"quote-face max-w-[320px] text-[29px] font-semibold leading-[1.12] tracking-[-0.025em]\" data-kid=\"1-1-5-2-2\" data-name=\"quote text\" id=\"quote-title\">\n                    A neighborhood market that keeps up with real life.\n                </h2>\n                <p class=\"mt-4 max-w-[285px] text-[11px] leading-[1.65] text-white/75\" data-kid=\"1-1-5-2-3\" data-name=\"quote attribution\">\n                    Made for busy kitchens and everyday wins.\n                </p>\n            </div>\n        </section>\n        <footer class=\"bg-[#FDFBF7] px-5 py-7\" data-kid=\"1-1-6\" data-name=\"footer bar\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-1-6-1\" data-name=\"footer header\">\n                <div data-kid=\"1-1-6-1-1\" data-name=\"footer brand container\">\n                    <p class=\"text-[10px] font-extrabold tracking-[0.14em] text-[#D61A3C]\" data-kid=\"1-1-6-1-1-1\" data-name=\"footer brand name\">\n                        MANIKANTA SUPER MARKET\n                    </p>\n                    <p class=\"mt-1 text-[10px] text-[#333333]/55\" data-kid=\"1-1-6-1-1-2\" data-name=\"footer tagline\">\n                        Good food. Good routine. Good neighbors.\n                    </p>\n                </div>\n                <span class=\"h-2.5 w-2.5 rounded-full bg-[#FFC107]\" data-kid=\"1-1-6-1-2\" data-name=\"footer decorative dot\">\n                </span>\n            </div>\n            <p class=\"mt-6 text-[9px] text-[#333333]/40\" data-kid=\"1-1-6-2\" data-name=\"copyright notice\">\n                © 2026 Manikanta Super Market. Made for everyday shopping.\n            </p>\n        </footer>\n        <a aria-label=\"Shop groceries\" class=\"fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#D61A3C] text-white shadow-[0_10px_24px_rgba(214,26,60,0.34)] ring-4 ring-white transition-transform duration-200 hover:scale-105 active:scale-95\" data-kid=\"1-1-7\" data-name=\"floating shop action button\" href=\"#shop\">\n            <i aria-hidden=\"true\" class=\"ti ti-shopping-bag\" data-kid=\"1-1-7-1\" data-name=\"shopping bag icon\" style=\"display:block;width:22px;height:22px;line-height:22px;font-size:22px;color:#FFFFFF\">\n            </i>\n        </a>\n    </main>\n</div>\n",
