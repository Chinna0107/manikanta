      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Poppins:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    background: #FDF8F0;\n    color: #08183A;\n    font-family: 'Poppins', sans-serif;\n  }\n\n  .market-serif { font-family: 'Playfair Display', serif; }\n  .story-rail { scrollbar-width: none; -ms-overflow-style: none; -webkit-overflow-scrolling: touch; }\n  .story-rail::-webkit-scrollbar { display: none; }\n  .story-card { scroll-snap-align: start; }\n  .soft-lift { box-shadow: 0 12px 28px rgba(8, 24, 58, 0.08); }\n  .hero-image { animation: hero-breathe 9s ease-in-out infinite; }\n  @keyframes hero-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.035); } }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto !important; }\n    .hero-image { animation: none !important; }\n    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }\n  }\n</style>\n<div class=\"min-h-screen overflow-x-hidden bg-[#FDF8F0] text-[#08183A] pb-28\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"relative z-10 flex items-center justify-between bg-[#FFC107] px-5 pb-4 pt-4\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n        <a aria-label=\"Manikanta Super Market home\" class=\"flex items-center gap-2.5 no-underline\" data-kid=\"1-1-1\" data-name=\"home link\" href=\"#top\">\n            <img alt=\"Manikanta Super Market logo\" class=\"h-10 w-10 object-contain\" data-kid=\"1-1-1-1\" data-name=\"manikanta super market logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/logo.png\"/>\n            <span class=\"flex flex-col leading-none\" data-kid=\"1-1-1-2\" data-name=\"brand name container\">\n                <span class=\"market-serif text-[18px] font-extrabold tracking-tight text-[#D61A3C]\" data-kid=\"1-1-1-2-1\" data-name=\"brand primary name\">\n                    Manikanta\n                </span>\n                <span class=\"mt-1 text-[8px] font-bold uppercase tracking-[0.22em] text-[#08183A]\" data-kid=\"1-1-1-2-2\" data-name=\"brand secondary name\">\n                    Super Market\n                </span>\n            </span>\n        </a>\n        <a class=\"flex items-center gap-2 rounded-full bg-white/90 px-3.5 py-2 text-[11px] font-bold text-[#08183A] shadow-sm no-underline transition-transform duration-200 hover:-translate-y-0.5 active:scale-95\" data-kid=\"1-1-2\" data-name=\"cart link\" href=\"#shop\">\n            <i aria-hidden=\"true\" class=\"ti ti-shopping-basket\" data-kid=\"1-1-2-1\" data-name=\"shopping basket icon\" style=\"color:#D61A3C;display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;font-size:16px;line-height:1;\">\n            </i>\n            <span data-kid=\"1-1-2-2\" data-name=\"cart text\">\n                Cart\n            </span>\n            <span class=\"flex h-5 min-w-5 items-center justify-center rounded-full bg-[#D61A3C] px-1 text-[10px] font-bold text-white\" data-dynamic=\"true\" data-kid=\"1-1-2-3\" data-name=\"cart items counter\" data-reason=\"cart count value updated by script\">\n                0\n            </span>\n        </a>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section class=\"px-4 pb-8 pt-5\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"mb-3 flex items-center justify-between px-1\" data-kid=\"1-2-1-1\" data-name=\"hero header info row\">\n                <span class=\"rounded-full bg-[#D61A3C] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-white\" data-kid=\"1-2-1-1-1\" data-name=\"hero label tag\">\n                    About the market\n                </span>\n                <span class=\"text-[10px] font-semibold uppercase tracking-[0.18em] text-[#08183A]/45\" data-kid=\"1-2-1-1-2\" data-name=\"hero slide progress indicator\">\n                    01 / 03\n                </span>\n            </div>\n            <div class=\"relative overflow-hidden rounded-[28px] bg-[#08183A] shadow-[0_18px_36px_rgba(8,24,58,0.18)]\" data-kid=\"1-2-1-2\" data-name=\"hero card\">\n                <div class=\"relative h-[264px] overflow-hidden\" data-kid=\"1-2-1-2-1\" data-name=\"hero image container\">\n                    <img alt=\"Colorful grocery produce display — Fahmi Huwaidy on Unsplash\" class=\"hero-image h-full w-full object-cover opacity-95\" data-kid=\"1-2-1-2-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1719427129634-c1794a1ebbd4?auto=format&w=900&q=80&fit=crop\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-b from-[#08183A]/5 via-[#08183A]/15 to-[#08183A]/65\" data-kid=\"1-2-1-2-1-2\" data-name=\"hero image gradient overlay\">\n                    </div>\n                    <div class=\"absolute bottom-4 left-4 flex items-center gap-2 rounded-full bg-white/90 px-3 py-2 text-[10px] font-semibold text-[#08183A] backdrop-blur-sm\" data-kid=\"1-2-1-2-1-3\" data-name=\"hero badge\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#3B5F4A]\" data-kid=\"1-2-1-2-1-3-1\" data-name=\"freshness indicator dot\">\n                        </span>\n                        Freshness first\n                    </div>\n                </div>\n                <div class=\"relative -mt-7 rounded-[26px] bg-white px-5 pb-5 pt-6\" data-kid=\"1-2-1-2-2\" data-name=\"hero content container\">\n                    <div class=\"mb-4 h-1 w-10 rounded-full bg-[#D61A3C]\" data-kid=\"1-2-1-2-2-1\" data-name=\"hero content accent line\">\n                    </div>\n                    <h1 class=\"market-serif max-w-[310px] text-[34px] font-bold leading-[1.08] tracking-[-0.025em] text-[#08183A]\" data-kid=\"1-2-1-2-2-2\" data-name=\"hero headline\">\n                        Good food begins with a good neighbor.\n                    </h1>\n                    <p class=\"mt-4 text-[13px] leading-[1.7] text-[#08183A]/70\" data-kid=\"1-2-1-2-2-3\" data-name=\"hero subheadline text\">\n                        Manikanta Super Market brings fresh groceries, pantry staples, and everyday essentials closer to home — with the care you expect from people who know your neighborhood.\n                    </p>\n                    <div class=\"mt-5 flex gap-2.5\" data-kid=\"1-2-1-2-2-4\" data-name=\"hero cta buttons container\">\n                        <a class=\"flex min-h-12 flex-1 items-center justify-center gap-2 rounded-2xl bg-[#FFC107] px-4 text-[12px] font-bold text-[#08183A] no-underline shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:scale-[0.98]\" data-kid=\"1-2-1-2-2-4-1\" data-name=\"shop fresh button\" href=\"#shop\">\n                            Shop fresh\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-2-1-2-2-4-1-1\" data-name=\"arrow right icon\" style=\"color:#08183A;display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;font-size:16px;line-height:1;\">\n                            </i>\n                        </a>\n                        <a class=\"flex min-h-12 flex-1 items-center justify-center rounded-2xl border border-[#08183A]/15 bg-[#FDF8F0] px-4 text-[12px] font-bold text-[#08183A] no-underline transition-all duration-200 hover:border-[#D61A3C]/40 hover:bg-[#FFF7D6] active:scale-[0.98]\" data-kid=\"1-2-1-2-2-4-2\" data-name=\"our promise button\" href=\"#promise\">\n                            Our promise\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"pb-9 pt-1\" data-kid=\"1-2-2\" data-name=\"our story section\" id=\"story\">\n            <div class=\"flex items-end justify-between px-5\" data-kid=\"1-2-2-1\" data-name=\"story section header row\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"story section title group\">\n                    <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#D61A3C]\" data-kid=\"1-2-2-1-1-1\" data-name=\"story pre-headline text\">\n                        The way we shop together\n                    </p>\n                    <h2 class=\"market-serif text-[25px] font-bold leading-tight text-[#08183A]\" data-kid=\"1-2-2-1-1-2\" data-name=\"story section title\">\n                        Why neighbors keep coming back\n                    </h2>\n                </div>\n                <span class=\"mb-1 text-[10px] font-semibold text-[#08183A]/45\" data-kid=\"1-2-2-1-2\" data-name=\"swipe instruction text\">\n                    Swipe →\n                </span>\n            </div>\n            <div aria-label=\"Our story cards\" class=\"story-rail mt-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-2\" data-kid=\"1-2-2-2\" data-name=\"story cards horizontal scroll rail\">\n                <article class=\"story-card min-w-[242px] overflow-hidden rounded-[24px] bg-white soft-lift\" data-kid=\"1-2-2-2-1\" data-name=\"first story card\">\n                    <div class=\"relative h-[143px] overflow-hidden\" data-kid=\"1-2-2-2-1-1\" data-name=\"first card image container\">\n                        <img alt=\"Grocer holding a paper bag of vegetables — Hans Ott on Unsplash\" class=\"h-full w-full object-cover transition-transform duration-500 hover:scale-105\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"first card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1663441261193-d0f5637743fb?auto=format&w=700&q=80&fit=crop\"/>\n                        <span class=\"absolute left-3 top-3 rounded-full bg-[#FFC107] px-2.5 py-1 text-[9px] font-bold uppercase tracking-wider text-[#08183A]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"first card index badge\">\n                            01\n                        </span>\n                    </div>\n                    <div class=\"p-4\" data-kid=\"1-2-2-2-1-2\" data-name=\"first card text content\">\n                        <h3 class=\"market-serif text-[20px] font-bold text-[#08183A]\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"first card title\">\n                            Local roots\n                        </h3>\n                        <p class=\"mt-2 text-[12px] leading-[1.65] text-[#08183A]/65\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"first card description\">\n                            We keep the market close, friendly, and easy to shop.\n                        </p>\n                    </div>\n                </article>\n                <article class=\"story-card min-w-[242px] overflow-hidden rounded-[24px] bg-white soft-lift\" data-kid=\"1-2-2-2-2\" data-name=\"second story card\">\n                    <div class=\"relative h-[143px] overflow-hidden\" data-kid=\"1-2-2-2-2-1\" data-name=\"second card image container\">\n                        <img alt=\"Fresh tomatoes on the vine — Lars Blankers on Unsplash\" class=\"h-full w-full object-cover transition-transform duration-500 hover:scale-105\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"second card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1518977822534-7049a61ee0c2?auto=format&w=700&q=80&fit=crop\"/>\n                        <span class=\"absolute left-3 top-3 rounded-full bg-[#D61A3C] px-2.5 py-1 text-[9px] font-bold uppercase tracking-wider text-white\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"second card index badge\">\n                            02\n                        </span>\n                    </div>\n                    <div class=\"p-4\" data-kid=\"1-2-2-2-2-2\" data-name=\"second card text content\">\n                        <h3 class=\"market-serif text-[20px] font-bold text-[#08183A]\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"second card title\">\n                            Picked with care\n                        </h3>\n                        <p class=\"mt-2 text-[12px] leading-[1.65] text-[#08183A]/65\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"second card description\">\n                            Fresh produce and daily essentials are selected for real family kitchens.\n                        </p>\n                    </div>\n                </article>\n                <article class=\"story-card min-w-[242px] overflow-hidden rounded-[24px] bg-white soft-lift\" data-kid=\"1-2-2-2-3\" data-name=\"third story card\">\n                    <div class=\"relative h-[143px] overflow-hidden\" data-kid=\"1-2-2-2-3-1\" data-name=\"third card image container\">\n                        <img alt=\"Delivery handoff with a grocery bag — Grab on Unsplash\" class=\"h-full w-full object-cover transition-transform duration-500 hover:scale-105\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"third card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1695653423034-d15c9f3d1328?auto=format&w=700&q=80&fit=crop\"/>\n                        <span class=\"absolute left-3 top-3 rounded-full bg-[#08183A] px-2.5 py-1 text-[9px] font-bold uppercase tracking-wider text-white\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"third card index badge\">\n                            03\n                        </span>\n                    </div>\n                    <div class=\"p-4\" data-kid=\"1-2-2-2-3-2\" data-name=\"third card text content\">\n                        <h3 class=\"market-serif text-[20px] font-bold text-[#08183A]\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"third card title\">\n                            Ready for your routine\n                        </h3>\n                        <p class=\"mt-2 text-[12px] leading-[1.65] text-[#08183A]/65\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"third card description\">\n                            Choose delivery or pickup when your week gets busy.\n                        </p>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <section class=\"bg-white px-5 py-9\" data-kid=\"1-2-3\" data-name=\"promise section\" id=\"promise\">\n            <div class=\"mb-5 flex items-end justify-between\" data-kid=\"1-2-3-1\" data-name=\"promise section header row\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"promise section title group\">\n                    <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#D61A3C]\" data-kid=\"1-2-3-1-1-1\" data-name=\"promise pre-headline text\">\n                        Small details, every day\n                    </p>\n                    <h2 class=\"market-serif text-[25px] font-bold leading-tight text-[#08183A]\" data-kid=\"1-2-3-1-1-2\" data-name=\"promise section title\">\n                        The Manikanta promise\n                    </h2>\n                </div>\n                <i aria-hidden=\"true\" class=\"ti ti-leaf\" data-kid=\"1-2-3-1-2\" data-name=\"leaf icon\" style=\"color:#3B5F4A;display:inline-flex;width:28px;height:28px;align-items:center;justify-content:center;font-size:28px;line-height:1;\">\n                </i>\n            </div>\n            <div class=\"grid grid-cols-2 gap-3\" data-kid=\"1-2-3-2\" data-name=\"promise grid\">\n                <div class=\"flex min-h-[112px] flex-col justify-between rounded-[22px] border border-[#08183A]/8 bg-[#FDF8F0] p-4 shadow-[0_8px_18px_rgba(8,24,58,0.05)] transition-transform duration-200 hover:-translate-y-0.5 active:scale-[0.98]\" data-kid=\"1-2-3-2-1\" data-name=\"freshness promise card\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-[#FFF1A8]\" data-kid=\"1-2-3-2-1-1\" data-name=\"freshness icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-leaf\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"leaf icon\" style=\"color:#3B5F4A;display:inline-flex;width:19px;height:19px;align-items:center;justify-content:center;font-size:19px;line-height:1;\">\n                        </i>\n                    </div>\n                    <span class=\"text-[12px] font-bold leading-tight text-[#08183A]\" data-kid=\"1-2-3-2-1-2\" data-name=\"freshness label text\">\n                        Fresh every morning\n                    </span>\n                </div>\n                <div class=\"flex min-h-[112px] flex-col justify-between rounded-[22px] border border-[#08183A]/8 bg-[#FDF8F0] p-4 shadow-[0_8px_18px_rgba(8,24,58,0.05)] transition-transform duration-200 hover:-translate-y-0.5 active:scale-[0.98]\" data-kid=\"1-2-3-2-2\" data-name=\"care promise card\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-[#FFE2E7]\" data-kid=\"1-2-3-2-2-1\" data-name=\"care icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-package-check\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"package check icon\" style=\"color:#D61A3C;display:inline-flex;width:19px;height:19px;align-items:center;justify-content:center;font-size:19px;line-height:1;\">\n                        </i>\n                    </div>\n                    <span class=\"text-[12px] font-bold leading-tight text-[#08183A]\" data-kid=\"1-2-3-2-2-2\" data-name=\"care label text\">\n                        Packed with care\n                    </span>\n                </div>\n                <div class=\"flex min-h-[112px] flex-col justify-between rounded-[22px] border border-[#08183A]/8 bg-[#FDF8F0] p-4 shadow-[0_8px_18px_rgba(8,24,58,0.05)] transition-transform duration-200 hover:-translate-y-0.5 active:scale-[0.98]\" data-kid=\"1-2-3-2-3\" data-name=\"value promise card\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-[#FFF1A8]\" data-kid=\"1-2-3-2-3-1\" data-name=\"value icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-tag\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"tag icon\" style=\"color:#08183A;display:inline-flex;width:19px;height:19px;align-items:center;justify-content:center;font-size:19px;line-height:1;\">\n                        </i>\n                    </div>\n                    <span class=\"text-[12px] font-bold leading-tight text-[#08183A]\" data-kid=\"1-2-3-2-3-2\" data-name=\"value label text\">\n                        Everyday value\n                    </span>\n                </div>\n                <div class=\"flex min-h-[112px] flex-col justify-between rounded-[22px] border border-[#08183A]/8 bg-[#FDF8F0] p-4 shadow-[0_8px_18px_rgba(8,24,58,0.05)] transition-transform duration-200 hover:-translate-y-0.5 active:scale-[0.98]\" data-kid=\"1-2-3-2-4\" data-name=\"pickup promise card\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-[#E5EEF8]\" data-kid=\"1-2-3-2-4-1\" data-name=\"pickup icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-3-2-4-1-1\" data-name=\"truck icon\" style=\"color:#08183A;display:inline-flex;width:19px;height:19px;align-items:center;justify-content:center;font-size:19px;line-height:1;\">\n                        </i>\n                    </div>\n                    <span class=\"text-[12px] font-bold leading-tight text-[#08183A]\" data-kid=\"1-2-3-2-4-2\" data-name=\"pickup label text\">\n                        Easy pickup\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section class=\"px-5 py-9\" data-kid=\"1-2-4\" data-name=\"call to action section\">\n            <div class=\"relative overflow-hidden rounded-[26px] bg-[#08183A] px-5 py-7 text-white shadow-[0_18px_34px_rgba(8,24,58,0.18)]\" data-kid=\"1-2-4-1\" data-name=\"call to action card\">\n                <div class=\"absolute -right-7 -top-10 h-28 w-28 rounded-full border-[18px] border-[#FFC107]/25\" data-kid=\"1-2-4-1-1\" data-name=\"decorative top circle\">\n                </div>\n                <div class=\"absolute -bottom-12 -left-8 h-28 w-28 rounded-full border-[12px] border-[#D61A3C]/25\" data-kid=\"1-2-4-1-2\" data-name=\"decorative bottom circle\">\n                </div>\n                <p class=\"relative text-[10px] font-bold uppercase tracking-[0.2em] text-[#FFC107]\" data-kid=\"1-2-4-1-3\" data-name=\"call to action pre-headline\">\n                    A little more care in every bag.\n                </p>\n                <p class=\"market-serif relative mt-4 text-[25px] font-bold leading-[1.18] text-white\" data-kid=\"1-2-4-1-4\" data-name=\"call to action headline\">\n                    From the first shelf check to the final handoff, we make everyday shopping feel simple, dependable, and personal.\n                </p>\n                <a class=\"relative mt-6 inline-flex min-h-12 items-center gap-2 rounded-2xl bg-[#D61A3C] px-5 text-[12px] font-bold text-white no-underline transition-all duration-200 hover:bg-[#B81633] active:scale-[0.98]\" data-kid=\"1-2-4-1-5\" data-name=\"start shopping button\" href=\"#top\" id=\"shop\">\n                    Start shopping\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-2-4-1-5-1\" data-name=\"arrow right icon\" style=\"color:#FFFFFF;display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;font-size:16px;line-height:1;\">\n                    </i>\n                </a>\n            </div>\n        </section>\n    </main>\n    <div class=\"fixed inset-x-0 bottom-0 z-40 border-t border-[#08183A]/10 bg-[#FFC107]/95 px-4 pb-[calc(env(safe-area-inset-bottom)+12px)] pt-3 backdrop-blur-md\" data-kid=\"1-3\" data-name=\"sticky footer shopping bar\">\n        <a class=\"flex min-h-12 w-full items-center justify-center gap-2 rounded-2xl bg-[#08183A] px-5 text-[13px] font-bold text-white no-underline shadow-[0_8px_18px_rgba(8,24,58,0.2)] transition-all duration-200 hover:bg-[#142b59] active:scale-[0.985]\" data-kid=\"1-3-1\" data-name=\"sticky start shopping button\" href=\"#shop\">\n            Start shopping\n            <i aria-hidden=\"true\" class=\"ti ti-shopping-basket\" data-kid=\"1-3-1-1\" data-name=\"shopping basket icon\" style=\"color:#FFC107;display:inline-flex;width:18px;height:18px;align-items:center;justify-content:center;font-size:18px;line-height:1;\">\n            </i>\n        </a>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-08-12T13:01:40.228512+00:00",
